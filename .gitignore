# Only reviewed project files are visible to Git by default.
/*
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/build.yml
!/.gitignore
!/CONTRIBUTING.md
!/LICENSE
!/README.md
!/THIRD_PARTY_NOTICES.md
!/animation.js
!/assets/
/assets/*
!/assets/artwork.jpg
!/assets/avatar.jpg
!/assets/avatar.svg
!/assets/background.jpg
!/assets/background.mp4
!/assets/contours.js
!/assets/windows-codex.ico
!/docs/
/docs/*
!/docs/development.md
!/docs/testing.md
!/extension/
/extension/*
!/extension/cdp.mjs
!/extension/default-video.mjs
!/extension/payload.mjs
!/extension/renderer.mjs
!/extension/video-wallpaper.mjs
!/extension/wallpaper.css
!/extension/windows.mjs
!/image-settings.js
!/index.html
!/media/
/media/*
!/media/MEDIA_NOTICE.md
!/project.json
!/style.css
!/tools/
/tools/*
!/tools/build-release.ps1
!/tools/extension.test.mjs
!/tools/gif.test.mjs
!/tools/settings.test.mjs
!/tools/verify-package.ps1
!/tools/video-wallpaper.test.mjs
!/tools/windows.test.mjs
!/windows/
/windows/*
!/windows/Activation.cs
!/windows/Launcher.cs
!/windows/Runtime.ps1
!/windows/launch.ps1
!/windows/verify-port.ps1
!/使用说明.md
